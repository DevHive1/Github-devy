{
  "name": "github-devy",
  "version": "1.0.0",
  "description": "Advanced AI-Powered Cloud Development Workspaces",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node build-server.js",
    "build:frontend": "vite build",
    "build:server": "node build-server.js",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist .agent_workspace",
    "lint": "./node_modules/.bin/tsc --noEmit",
    "type-check": "./node_modules/.bin/tsc --noEmit",
    "test": "node tools/platform_test.js",
    "syntax-check": "node tools/syntax-check.js",
    "eslint-check": "node tools/eslint-check.js",
    "ts-check": "node tools/ts-check.js",
    "check-all": "npm run syntax-check && npm run eslint-check && npm run ts-check",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"server/**/*.ts\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"server/**/*.ts\" \"*.js\" \"*.json\"",
    "audit:fix": "npm audit fix",
    "prepare": "npm run build",
    "docker:build": "docker build -t github-devy .",
    "docker:run": "docker run -p 9876:9876 -d github-devy",
    "docker:dev": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "cloud-ide",
    "ai-powered",
    "terminal",
    "workspace",
    "development",
    "typescript",
    "react"
  ],
  "author": "DevHive1",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DevHive1/Github-devy/issues"
  },
  "homepage": "https://github.com/DevHive1/Github-devy",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevHive1/Github-devy.git"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.9.0-beta.18",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.6.0",
    "body-parser": "^1.20.6",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.42.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "protobufjs": "^7.6.5",
    "puppeteer-core": "^25.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.28.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
