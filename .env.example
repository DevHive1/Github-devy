# Github-devy Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=9876
NODE_ENV=development

# ============================================
# AI Provider Configuration
# ============================================

# Google Gemini API Key (Required for AI features)
# Get your API key from: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# Ollama Configuration (Optional - for local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LM Studio Configuration (Optional - for local LLM)
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model

# ============================================
# GitHub Integration
# ============================================
# Generate a personal access token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ============================================
# Database Configuration
# ============================================

# PostgreSQL (Primary Database - Recommended)
# Format: postgresql://username:password@host:port/database
POSTGRES_URL=postgresql://devy:devy123@localhost:5432/devy

# MongoDB (Optional - for document storage)
# Format: mongodb://username:password@host:port/database
DATABASE_URL=mongodb://localhost:27017/github-devy

# ============================================
# Redis Configuration (for caching and sessions)
# ============================================
# Format: redis://host:port
REDIS_URL=redis://localhost:6379

# ============================================
# Security Configuration
# ============================================
# Session secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# JWT secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# ============================================
# Workspace Configuration
# ============================================
WORKSPACE_ROOT=.agent_workspace
MAX_WORKSPACE_SIZE=1073741824  # 1GB

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, pretty

# ============================================
# Proxy Configuration (for development)
# ============================================
PROXY_TARGET=http://localhost:3000
